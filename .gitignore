# Runtime log artifacts — see CLAUDE_STATUS_BAR_DEBUG in claude-status-bar.
.log/

# Installed segment-selection config — written by install.sh into ~/.claude.
# The in-repo source tree ships no config so the renderer shows every segment.
claude-status-bar.conf

# Python bytecode caches.
__pycache__/
*.pyc

# Rust build output.
/target/

# BEGIN programming-prompts-cursor (managed by linux_programming_setup)
# Managed copies from programming_prompts — do not ignore other .cursor/skills/*
.cursor/skills/programming-prompts/
.cursor/rules/programming-prompts-always-on.mdc
# END programming-prompts-cursor
