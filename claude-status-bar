#!/bin/sh
# Launch the Rust status-line binary from a source checkout.
# The installer copies target/release/claude-status-bar itself into ~/.claude.
dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
for candidate in "$dir/target/release/claude-status-bar" "$dir/target/debug/claude-status-bar"; do
    if [ -x "$candidate" ]; then
        exec "$candidate" "$@"
    fi
done
printf 'claude-status-bar is not built. Run cargo build --release in %s\n' "$dir" >&2
exit 1
